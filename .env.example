# ---- Server ----
NODE_ENV=development
PORT=4000
# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://minutemate:minutemate@localhost:5433/minutemate?schema=public
# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated list of browser origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173
# Cookie settings. For a cross-site deployment (client and API on different
# domains) use COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy (Render, Railway, ...)
TRUST_PROXY=false

# ---- AI provider ----
# openai | anthropic | openai-compatible (any server speaking the chat-completions API)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
# Only for openai-compatible (or to override the default endpoint)
AI_BASE_URL=
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
# Rough token budget per chunk sent to the model. Tune to your model.
AI_CHUNK_TOKENS=6000
AI_CHUNK_OVERLAP_SEGMENTS=3
# Cost guards
MAX_TRANSCRIPT_CHARS=400000
MAX_CHUNKS_PER_MEETING=20
MAX_ACTIVE_JOBS_PER_USER=3

# ---- Uploads ----
MAX_FILE_BYTES=5242880

# ---- Client (Vite) ----
# Leave empty in development: Vite proxies /api to the server.
# Set to the API origin if the client is hosted separately without a rewrite.
VITE_API_URL=
